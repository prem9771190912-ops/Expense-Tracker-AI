# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (MongoDB local or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/expense-tracker

# Authentication Secret
JWT_SECRET=demo_jwt_secret_key_change_in_production

# AI Service (OpenRouter API Key for automatic categorization & insights)
OPENROUTER_API_KEY=demo_openrouter_api_key

# Sendinblue / Brevo Email Service Configuration
# Create account at https://app.brevo.com -> SMTP & API -> Generate API Key
SENDINBLUE_API_KEY=your_sendinblue_api_key_here
SENDINBLUE_SENDER_EMAIL=your_email@gmail.com
SENDINBLUE_SENDER_NAME=Expense Tracker

# Cashfree Sandbox Payment Gateway Configuration
# Obtain Sandbox App ID & Secret Key from https://merchant.cashfree.com/ (Switch to Sandbox -> Developers -> API Keys)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENVIRONMENT=SANDBOX

