# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (MongoDB local or Atlas URI)
MONGODB_URI=mongodb://localhost:27017/expense-tracker

# Authentication Secret
JWT_SECRET=demo_jwt_secret_key_change_in_production

# Nodemailer / Gmail SMTP Configuration
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM=your_gmail_address@gmail.com

# AI Service (OpenRouter API Key for automatic categorization & insights)
OPENROUTER_API_KEY=demo_openrouter_api_key
